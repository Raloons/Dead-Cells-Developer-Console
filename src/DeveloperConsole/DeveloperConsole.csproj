<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ModName>DeveloperConsole</ModName>
    <ModType>mod</ModType>
    <ModMain>DeveloperConsole.DeveloperConsoleMod</ModMain>
    <!-- Deployment is always a separate, explicit step. -->
    <AutoInstallMod>false</AutoInstallMod>
    <Authors>Raloons</Authors>
    <Description>A standalone developer console for Dead Cells Core Modding.</Description>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-alpha</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <!-- Keep compiler debug records and portable PDB source names generic. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/DeveloperConsole</PathMap>
    <GameVersion>35</GameVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeadCellsCoreModding.MDK" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Non-empty PackAssets is required by the DCCM pak target. This is a
         code-only mod; the marker file is not used at runtime. -->
    <PackAssets Include="assets/**/*" RootInPak="developerconsole" />
  </ItemGroup>

</Project>
